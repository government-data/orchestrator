{
  "messages": {
    "ArtefactRecord": {
      "$defs": {
        "FolderRecord": {
          "additionalProperties": false,
          "description": "A folder, as a record names it: found again by id, else by name, else\ncreated with that id.",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`orchestrator.json`: one deployed version of a flow.",
      "properties": {
        "allow_overlap": {
          "default": false,
          "type": "boolean"
        },
        "deploy": {
          "type": "string"
        },
        "deployed_at": {
          "format": "date-time",
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "flow": {
          "description": "The flow: the same id in every version.",
          "type": "string"
        },
        "folder": {
          "$ref": "#/$defs/FolderRecord"
        },
        "format": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "on_interrupt": {
          "default": null,
          "description": "`none`, `repeat` or `continue`; absent: the installation's rule.",
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "additionalProperties": true,
          "default": {},
          "description": "The flow's parameters (an object).",
          "type": "object"
        },
        "sha256": {
          "type": "string"
        },
        "timeout_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "The version tag the deploy gave it.",
          "type": "string"
        }
      },
      "required": [
        "format",
        "flow",
        "deploy",
        "version",
        "sha256",
        "folder",
        "name",
        "kind",
        "timeout_secs",
        "deployed_at"
      ],
      "title": "ArtefactRecord",
      "type": "object"
    },
    "Claim": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A runner asks for a run of its engine and line.",
      "properties": {
        "runner": {
          "description": "The runner, unique on its machine (several may run on one).",
          "type": "string"
        }
      },
      "required": [
        "runner"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Claimed": {
      "$defs": {
        "Resume": {
          "additionalProperties": false,
          "description": "The run that tells the engine where the run it repeats was.",
          "properties": {
            "engine_ref": {
              "description": "The engine's reference of the previous run, if it reported one.",
              "type": [
                "string",
                "null"
              ]
            },
            "last_detail": {
              "description": "The previous run's last progress detail, if it reported one.",
              "type": [
                "string",
                "null"
              ]
            },
            "previous_run": {
              "type": "string"
            }
          },
          "required": [
            "previous_run"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A run handed to a runner, under a lease.",
      "properties": {
        "attempt": {
          "description": "Its attempt (the first is 1).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "flow": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "lease": {
          "description": "The lease the runner names in every call about this run: a call with\nanother lease is refused, so an expired holder changes nothing.",
          "type": "string"
        },
        "lease_until": {
          "format": "date-time",
          "type": "string"
        },
        "parameters": {
          "description": "The run's parameters (the flow's with the fire's over them)."
        },
        "resume": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resume"
            },
            {
              "type": "null"
            }
          ],
          "description": "With `continue`, where the run it repeats was."
        },
        "run": {
          "type": "string"
        },
        "timeout_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "variables": {
          "additionalProperties": true,
          "description": "The flow's variables, secret ones opened: for the engine only,\nnever logged or reported back.",
          "type": "object"
        }
      },
      "required": [
        "run",
        "flow",
        "kind",
        "parameters",
        "attempt",
        "timeout_secs",
        "lease",
        "lease_until"
      ],
      "title": "Claimed",
      "type": "object"
    },
    "DeployClaimed": {
      "$defs": {
        "FolderRecord": {
          "additionalProperties": false,
          "description": "A folder, as a record names it: found again by id, else by name, else\ncreated with that id.",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "type": "object"
        },
        "ScheduleSource": {
          "description": "Where an external schedule is, so that the runner can disable it.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "A cron line: its file and its line number (from 1).",
              "properties": {
                "file": {
                  "type": "string"
                },
                "kind": {
                  "const": "cron",
                  "type": "string"
                },
                "line": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "file",
                "line"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A systemd timer, by its unit name.",
              "properties": {
                "kind": {
                  "const": "timer",
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "unit"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A deploy handed to a runner of its engine and line, on the cluster its\nartefact is on. Claiming again before its finish hands the same deploy\nto the same runner, so a runner that restarts takes it up again.",
      "properties": {
        "allow_overlap": {
          "default": false,
          "type": "boolean"
        },
        "deploy": {
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "The rest of the flow's settings, for `orchestrator.json`.",
          "type": "string"
        },
        "flow": {
          "type": "string"
        },
        "folder": {
          "$ref": "#/$defs/FolderRecord",
          "description": "The flow's folder and name, the managed layout's."
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "on_interrupt": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "parameters": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "schedules": {
          "default": [],
          "description": "The external schedules that start it, disabled by the runner once\nthe flow is ready.",
          "items": {
            "$ref": "#/$defs/ScheduleSource"
          },
          "type": "array"
        },
        "source_path": {
          "description": "The artefact's absolute path on the cluster now.",
          "type": "string"
        },
        "source_sha256": {
          "description": "Its SHA-256 as the runner found it: a different artefact there now\nis not deployed.",
          "type": "string"
        },
        "timeout_secs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "deploy",
        "flow",
        "source_path",
        "source_sha256",
        "folder",
        "name",
        "kind",
        "timeout_secs"
      ],
      "title": "DeployClaimed",
      "type": "object"
    },
    "DeployFinish": {
      "$defs": {
        "DeployState": {
          "description": "How a deploy ended.",
          "oneOf": [
            {
              "const": "succeeded",
              "description": "The artefact is in the managed layout, tagged and recorded.",
              "type": "string"
            },
            {
              "const": "failed",
              "description": "It was not placed: the artefact stays where it was.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`POST /internal/deploys/{id}/finish`: a deploy's end. Sending the same\nfinish again changes nothing; another one after it is refused.",
      "properties": {
        "external_disabled": {
          "description": "Every external schedule that starts it was disabled: if not, the\nflow's schedules are created paused.",
          "type": "boolean"
        },
        "path": {
          "description": "Where the artefact is now (absolute), on success.",
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "description": "The SHA-256 of what was placed (lowercase hex), on success.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/DeployState"
        },
        "version": {
          "description": "The version tag the deploy gave it, on success.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "state",
        "external_disabled"
      ],
      "title": "DeployFinish",
      "type": "object"
    },
    "Descriptor": {
      "$defs": {
        "RunKind": {
          "additionalProperties": false,
          "description": "A kind of run an engine runs, with the JSON Schema of its parameters.",
          "properties": {
            "name": {
              "description": "`[a-z][a-z0-9_]`, at most 40 bytes.",
              "type": "string"
            },
            "parameters": {
              "description": "The JSON Schema (an object) a run's parameters of this kind meet."
            }
          },
          "required": [
            "name",
            "parameters"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A runner's descriptor of its engine, sent when it starts.",
      "properties": {
        "concurrency": {
          "description": "How many runs this runner runs at once.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "engine": {
          "pattern": "^[a-z][a-z0-9-]{0,39}$",
          "type": "string"
        },
        "engine_version": {
          "description": "The engine's exact version.",
          "type": "string"
        },
        "kinds": {
          "items": {
            "$ref": "#/$defs/RunKind"
          },
          "type": "array"
        },
        "line": {
          "description": "The engine's major line, or `-` for an engine with one.",
          "pattern": "^(-|[a-z0-9.]{1,16})$",
          "type": "string"
        },
        "port": {
          "description": "The port version the runner speaks.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "engine",
        "line",
        "engine_version",
        "port",
        "kinds",
        "concurrency"
      ],
      "title": "Descriptor",
      "type": "object"
    },
    "Finish": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A runner reports a run's end.",
      "properties": {
        "counts": {
          "additionalProperties": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "description": "Named counts (rows, statements…), never values.",
          "type": "object"
        },
        "error_class": {
          "description": "The engine's class of the error (`[a-z0-9_]`, at most 64), never its\nmessage.",
          "type": [
            "string",
            "null"
          ]
        },
        "interruption": {
          "default": null,
          "description": "Why it was cut, if it did not fail by itself.",
          "enum": [
            "system",
            "runner_stopped",
            "runner_restarted",
            "runner_lost",
            "runner_isolated",
            "low_disk",
            null
          ]
        },
        "lease": {
          "type": "string"
        },
        "state": {
          "enum": [
            "succeeded",
            "failed",
            "timed_out",
            "cancelled"
          ],
          "type": "string"
        }
      },
      "required": [
        "lease",
        "state"
      ],
      "title": "Finish",
      "type": "object"
    },
    "Found": {
      "$defs": {
        "Flag": {
          "additionalProperties": false,
          "description": "One thing flagged: its kind and what the engine names (a node, a path,\nan extension), at most 500 bytes.",
          "properties": {
            "kind": {
              "$ref": "#/$defs/FlagKind"
            },
            "subject": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "subject"
          ],
          "type": "object"
        },
        "FlagKind": {
          "description": "What the engine flags for review before an artefact is imported; an\nimport names every kind its artefacts carry as confirmed.",
          "oneOf": [
            {
              "const": "code",
              "description": "It runs code of its own (a script node).",
              "type": "string"
            },
            {
              "const": "path",
              "description": "It reads or writes a path out of its folder, or one the runner does\nnot see.",
              "type": "string"
            },
            {
              "const": "missing",
              "description": "It needs an extension the engine does not have.",
              "type": "string"
            }
          ]
        },
        "FoundArtefact": {
          "additionalProperties": false,
          "description": "An artefact on the cluster that no deploy placed.",
          "properties": {
            "flags": {
              "default": [],
              "items": {
                "$ref": "#/$defs/Flag"
              },
              "type": "array"
            },
            "path": {
              "description": "Its absolute path on the cluster.",
              "type": "string"
            },
            "segments": {
              "description": "Its path under the engine's root, by folder: the first proposes the\nfolder, the rest the name.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "sha256": {
              "description": "The SHA-256 of its content (lowercase hex), as the engine digests it.",
              "type": "string"
            },
            "size_bytes": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "path",
            "segments",
            "sha256",
            "size_bytes"
          ],
          "type": "object"
        },
        "FoundCalendar": {
          "description": "When an external schedule starts its artefact.",
          "oneOf": [
            {
              "description": "A 5-field cron the orchestrator's schedules take as it is.",
              "properties": {
                "calendar": {
                  "const": "cron",
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "calendar",
                "value"
              ],
              "type": "object"
            },
            {
              "description": "No equivalent (`@reboot`, `OnBootSec`, a calendar the scanner does\nnot convert): counted for a person, never created.",
              "properties": {
                "calendar": {
                  "const": "unsupported",
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "calendar",
                "value"
              ],
              "type": "object"
            }
          ]
        },
        "FoundSchedule": {
          "additionalProperties": false,
          "description": "An external schedule that starts a found artefact.",
          "properties": {
            "artefact": {
              "description": "The found artefact's path it starts.",
              "type": "string"
            },
            "calendar": {
              "$ref": "#/$defs/FoundCalendar"
            },
            "parameters": {
              "additionalProperties": true,
              "default": {},
              "description": "The parameters its command passes, as the engine reads them.",
              "type": "object"
            },
            "persistent": {
              "default": false,
              "description": "Whether it also keeps a missed start for later (`Persistent=true`).",
              "type": "boolean"
            },
            "source": {
              "$ref": "#/$defs/ScheduleSource"
            },
            "timezone": {
              "description": "The cluster's time zone (IANA), if known.",
              "type": [
                "string",
                "null"
              ]
            },
            "user": {
              "description": "The account it runs as.",
              "type": "string"
            }
          },
          "required": [
            "source",
            "user",
            "calendar",
            "artefact"
          ],
          "type": "object"
        },
        "ScheduleSource": {
          "description": "Where an external schedule is, so that the runner can disable it.",
          "oneOf": [
            {
              "additionalProperties": false,
              "description": "A cron line: its file and its line number (from 1).",
              "properties": {
                "file": {
                  "type": "string"
                },
                "kind": {
                  "const": "cron",
                  "type": "string"
                },
                "line": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "kind",
                "file",
                "line"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "description": "A systemd timer, by its unit name.",
              "properties": {
                "kind": {
                  "const": "timer",
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "unit"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`PUT /internal/engines/{engine}/{line}/found`: everything found now; it\nreplaces the runner's previous report.",
      "properties": {
        "artefacts": {
          "items": {
            "$ref": "#/$defs/FoundArtefact"
          },
          "type": "array"
        },
        "schedules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FoundSchedule"
          },
          "type": "array"
        }
      },
      "required": [
        "artefacts"
      ],
      "title": "Found",
      "type": "object"
    },
    "FoundAnswer": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "The answer to a report of what was found.",
      "properties": {
        "kept": {
          "description": "Artefacts kept to be imported.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "relinked": {
          "description": "Purged flows whose artefact appeared again, imported over their\nsame record.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kept",
        "relinked"
      ],
      "title": "FoundAnswer",
      "type": "object"
    },
    "Hold": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "The engine's drain hold: while it is in force the orchestrator answers\nno claim of that engine and counts what still runs.",
      "properties": {
        "hold": {
          "description": "The hold's id: asking again with it extends the hold.",
          "type": "string"
        },
        "until": {
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "hold",
        "until"
      ],
      "title": "Hold",
      "type": "object"
    },
    "HoldAnswer": {
      "$defs": {
        "HoldState": {
          "description": "A hold's state.",
          "oneOf": [
            {
              "const": "free",
              "description": "Nothing of the engine runs: it may restart.",
              "type": "string"
            },
            {
              "const": "draining",
              "description": "Runs of the engine are still running.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "The answer to a hold.",
      "properties": {
        "running": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/HoldState"
        }
      },
      "required": [
        "state",
        "running"
      ],
      "title": "HoldAnswer",
      "type": "object"
    },
    "Inventory": {
      "$defs": {
        "ArtefactRecord": {
          "additionalProperties": false,
          "description": "`orchestrator.json`: one deployed version of a flow.",
          "properties": {
            "allow_overlap": {
              "default": false,
              "type": "boolean"
            },
            "deploy": {
              "type": "string"
            },
            "deployed_at": {
              "format": "date-time",
              "type": "string"
            },
            "description": {
              "default": "",
              "type": "string"
            },
            "flow": {
              "description": "The flow: the same id in every version.",
              "type": "string"
            },
            "folder": {
              "$ref": "#/$defs/FolderRecord"
            },
            "format": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "on_interrupt": {
              "default": null,
              "description": "`none`, `repeat` or `continue`; absent: the installation's rule.",
              "type": [
                "string",
                "null"
              ]
            },
            "parameters": {
              "additionalProperties": true,
              "default": {},
              "description": "The flow's parameters (an object).",
              "type": "object"
            },
            "sha256": {
              "type": "string"
            },
            "timeout_secs": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "version": {
              "description": "The version tag the deploy gave it.",
              "type": "string"
            }
          },
          "required": [
            "format",
            "flow",
            "deploy",
            "version",
            "sha256",
            "folder",
            "name",
            "kind",
            "timeout_secs",
            "deployed_at"
          ],
          "type": "object"
        },
        "FolderRecord": {
          "additionalProperties": false,
          "description": "A folder, as a record names it: found again by id, else by name, else\ncreated with that id.",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "type": "object"
        },
        "InventoryItem": {
          "additionalProperties": false,
          "description": "One record the runner found, with the folder it is in.",
          "properties": {
            "path": {
              "description": "The artefact's absolute path on the cluster.",
              "type": "string"
            },
            "record": {
              "$ref": "#/$defs/ArtefactRecord"
            }
          },
          "required": [
            "path",
            "record"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "`PUT /internal/engines/{engine}/{line}/inventory`, at start: every\nrecord on the cluster.",
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/InventoryItem"
          },
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "Inventory",
      "type": "object"
    },
    "InventoryAnswer": {
      "$defs": {
        "SkipReason": {
          "description": "Why a record was not taken.",
          "oneOf": [
            {
              "const": "invalid",
              "description": "The record is malformed or of a newer format.",
              "type": "string"
            },
            {
              "const": "older_version",
              "description": "A newer version of the same flow is on the cluster.",
              "type": "string"
            },
            {
              "const": "on_live_cluster",
              "description": "The flow is placed on a cluster that is live.",
              "type": "string"
            },
            {
              "const": "path_registered",
              "description": "Another flow is registered at that path.",
              "type": "string"
            }
          ]
        },
        "Skipped": {
          "additionalProperties": false,
          "description": "A record not taken, and why.",
          "properties": {
            "path": {
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/SkipReason"
            }
          },
          "required": [
            "path",
            "reason"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "What the orchestrator did with an inventory.",
      "properties": {
        "already_adopted": {
          "description": "The cluster had adopted its inventory before: nothing changed.",
          "type": "boolean"
        },
        "folders_created": {
          "default": 0,
          "description": "Folders created again because neither their id nor name existed.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "reattached": {
          "default": [],
          "description": "Known flows moved to this cluster, their runs, schedules,\nvariables and folder kept (flow ids).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "registered": {
          "default": [],
          "description": "Unknown flows registered again with their same id.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "skipped": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Skipped"
          },
          "type": "array"
        }
      },
      "required": [
        "already_adopted"
      ],
      "title": "InventoryAnswer",
      "type": "object"
    },
    "Lock": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A run asks for a lock, or gives it back.",
      "properties": {
        "lease": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "lease",
        "name"
      ],
      "title": "Lock",
      "type": "object"
    },
    "LockAnswer": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Whether the run holds the lock now. Not granted: another running run\nholds it; ask again later, the run's lease renewed meanwhile.",
      "properties": {
        "granted": {
          "type": "boolean"
        }
      },
      "required": [
        "granted"
      ],
      "title": "LockAnswer",
      "type": "object"
    },
    "Logs": {
      "$defs": {
        "LogLine": {
          "additionalProperties": false,
          "description": "A numbered log line: numbers grow from 1 within a run, and a line sent\ntwice is kept once.",
          "properties": {
            "line": {
              "type": "string"
            },
            "seq": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "stream": {
              "$ref": "#/$defs/LogStream"
            }
          },
          "required": [
            "seq",
            "stream",
            "line"
          ],
          "type": "object"
        },
        "LogStream": {
          "description": "Where a log line came from.",
          "oneOf": [
            {
              "enum": [
                "stdout",
                "stderr"
              ],
              "type": "string"
            },
            {
              "const": "system",
              "description": "The runner's own messages (start, timeout, cancel).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A runner appends log lines.",
      "properties": {
        "lease": {
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/LogLine"
          },
          "type": "array"
        }
      },
      "required": [
        "lease",
        "lines"
      ],
      "title": "Logs",
      "type": "object"
    },
    "Registered": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "The orchestrator's answer to a registration.",
      "properties": {
        "lease_secs": {
          "description": "How long a claimed run's lease lasts.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "port": {
          "description": "The port version both speak.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "renew_every_secs": {
          "description": "How often the runner renews a lease while it runs.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "port",
        "lease_secs",
        "renew_every_secs"
      ],
      "title": "Registered",
      "type": "object"
    },
    "Release": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "The end of a hold.",
      "properties": {
        "hold": {
          "type": "string"
        }
      },
      "required": [
        "hold"
      ],
      "title": "Release",
      "type": "object"
    },
    "Renew": {
      "$defs": {
        "Progress": {
          "additionalProperties": false,
          "description": "How far a run is.",
          "properties": {
            "detail": {
              "description": "A short step name (no data), at most 200 bytes.",
              "type": [
                "string",
                "null"
              ]
            },
            "fraction": {
              "description": "0 to 1, if the engine knows.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "A runner renews its lease while it runs.",
      "properties": {
        "engine_ref": {
          "description": "The engine's own reference of the run (a query id), stored before\nthe engine starts it, so that a retry can stop it first.",
          "type": [
            "string",
            "null"
          ]
        },
        "lease": {
          "type": "string"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/Progress"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lease"
      ],
      "title": "Renew",
      "type": "object"
    },
    "Renewed": {
      "$defs": {
        "RenewAction": {
          "description": "What a runner does after a renewal.",
          "oneOf": [
            {
              "const": "continue",
              "description": "Go on.",
              "type": "string"
            },
            {
              "const": "cancel",
              "description": "Someone cancelled it: stop the engine and finish it `cancelled`.",
              "type": "string"
            },
            {
              "const": "held",
              "description": "The engine is held: go on with this run, claim nothing new.",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "The answer to a renewal.",
      "properties": {
        "action": {
          "$ref": "#/$defs/RenewAction"
        },
        "lease_until": {
          "format": "date-time",
          "type": "string"
        },
        "scan": {
          "description": "Someone asked for a scan: report what is on the cluster now, without\nwaiting for the next timed report. Absent means false, and it is\nsent only when true, so an answer without it reads as before; it is\nsent again at each renewal until the runner's next found report.",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "lease_until"
      ],
      "title": "Renewed",
      "type": "object"
    }
  },
  "port": 1
}
